  "keyFeatures": [
    "Role-based access control with USUARIO, ADMIN, and SUPERADMIN roles",
    "Court (cancha) management supporting football, tennis, basketball, and volleyball",
    "Booking system with conflict detection and time-slot validation",
    "JWT authentication via HTTP-only cookies",
    "Admin dashboard for confirming or cancelling reservations",
    "Superadmin panel with global reports, user management, and role assignment",
    "PostgreSQL database with Prisma ORM",
    "Next.js App Router with server-side rendering"
  ],
